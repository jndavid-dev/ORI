{%- comment -%}
  ORI redesign — numbered steps ("How ordering works"). One block per
  step: number, icon, title, text. Steps sit in a row joined by a teal
  line on desktop and stack on mobile; the column count follows the
  number of blocks. Dark band by default (Style: Light for a pale
  band). Replaces sections/gvm-how-it-works.liquid on redesigned pages
  with the same step blocks.
{%- endcomment -%}
{{ 'gvm-css-main.css' | asset_url | stylesheet_tag }}
{%- render 'ori-fonts' -%}

{%- liquid
  assign custom_class = section.settings.custom_class
  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless
-%}
<div
  class="ori ori-section ori-steps ori-steps--{{ section.settings.style }}{{ custom_class }}"
  style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ori-wrap">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="ori-head">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="ori-h2">
              {%- if section.settings.heading_accent != blank -%}
                <span class="ori-accent">{{ section.settings.heading_accent }}</span>
              {%- endif -%}
              {{- section.settings.heading -}}
            </h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="ori-head__intro">{{ section.settings.intro }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank -%}
          <a class="ori-btn ori-btn--teal" href="{{ section.settings.button_link | default: '#' }}">
            {{- section.settings.button_label -}}
            {%- render 'ori-icon', icon: 'arrow' -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ol class="ori-steps__list" style="--ori-n: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          <li class="ori-step" {{ block.shopify_attributes }}>
            <div class="ori-step__top">
              <span class="ori-step__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="ori-step__icon" aria-hidden="true">{%- render 'ori-icon', icon: block.settings.icon -%}</span>
            </div>
            <h3 class="ori-step__title">
              <span class="ori-sr">Step {{ forloop.index }}: </span>
              {{- block.settings.title -}}
            </h3>
            {%- if block.settings.text != blank -%}
              <div class="ori-step__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ORI Steps",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "dark", "label": "Dark band" },
        { "value": "light", "label": "Light band" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading line 1 (teal)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How ordering works"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Optional, next to the heading."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "form", "label": "Form" },
            { "value": "check", "label": "Check" },
            { "value": "tag", "label": "Price tag" },
            { "value": "card", "label": "Payment card" },
            { "value": "search", "label": "Search" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Step title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORI Steps",
      "blocks": [
        { "type": "step", "settings": { "icon": "truck" } },
        { "type": "step", "settings": { "icon": "form" } },
        { "type": "step", "settings": { "icon": "check" } }
      ]
    }
  ]
}
{% endschema %}
