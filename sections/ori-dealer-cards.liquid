{%- comment -%}
  ORI redesign — Installer / dealer cards. Teal band with translucent
  cards, each with a heading, a line of copy and a button (white or
  dark). Two across on desktop, stacked on tablet and mobile.
{%- endcomment -%}
{{ 'gvm-css-main.css' | asset_url | stylesheet_tag }}
{%- render 'ori-fonts' -%}
{%- assign cards = section.blocks | where: 'type', 'card' -%}
{%- if cards.size > 0 -%}
  <div
    class="ori ori-section ori-dealers"
    style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="ori-wrap">
      <ul class="ori-dealers__grid" role="list">
        {%- for block in cards -%}
          <li class="ori-dealer" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="ori-dealer__title">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="ori-dealer__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.link != blank -%}
              <a class="ori-btn ori-dealer__btn ori-dealer__btn--{{ block.settings.button_style }}" href="{{ block.settings.link }}">
                {{- block.settings.button_label -}}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ORI Dealer cards",
  "settings": [
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Find an installer" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Button link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "light", "label": "White" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [{ "name": "ORI Dealer cards" }]
}
{% endschema %}
