{%- comment -%}
  ORI redesign — GVM upgrades band for the home page. Dark band: heading,
  intro and vehicle tabs on the left; the selected vehicle's figures card
  on the right (GVM / GCM factory → top stage, towing), its stages with
  the GVM each one is rated to, and its buttons.

  Each vehicle points at its GVM collection (the vehicle page). The main
  button opens it; the second button opens the same page at its quote form
  (the ORI GVM Quote section's anchor, #quote by default).

  Figures are metafield-first: pick the vehicle's top-stage GVM product
  and the card reads its original_gvm / upgraded_gvm / original_gcm /
  upgraded_gcm / towing metafields (variant, then product; custom then
  ori namespace — same lookup as sections/ori-gvm-product.liquid). The
  typed values — taken from each collection's specification table — are
  the fallback for anything the product doesn't have.

  Every vehicle panel is rendered server-side; assets/ori-home.js only
  switches tabs, so there's no templating in JavaScript.
{%- endcomment -%}
{%- liquid
  assign vehicles = section.blocks | where: 'type', 'vehicle'
  assign uid = 'ori-hgvm-' | append: section.id
-%}
<div
  class="ori ori-section ori-hgvm"
  style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
  data-ori-tabs
>
  <div class="ori-wrap ori-hgvm__grid">
    <div class="ori-hgvm__copy">
      <h2 class="ori-h2">
        {%- if section.settings.heading_1 != blank -%}
          <span class="ori-accent">{{ section.settings.heading_1 }}</span>
          {{- ' ' -}}
        {%- endif -%}
        {{- section.settings.heading_2 -}}
      </h2>
      {%- if section.settings.intro != blank -%}
        <p class="ori-hgvm__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
      {%- if vehicles.size > 1 -%}
        <div class="ori-hgvm__tabs" role="tablist" aria-label="Choose vehicle">
          {%- for block in vehicles -%}
            <button
              type="button"
              class="ori-hgvm__tab"
              role="tab"
              id="{{ uid }}-tab-{{ forloop.index }}"
              aria-controls="{{ uid }}-panel-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {% unless forloop.first %}tabindex="-1"{% endunless %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.name -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ori-hgvm__panels">
      {%- for block in vehicles -%}
        {%- liquid
          assign p = block.settings.product
          assign f_gvm_old = block.settings.original_gvm
          assign f_gvm_new = block.settings.upgraded_gvm
          assign f_gcm_old = block.settings.original_gcm
          assign f_gcm_new = block.settings.upgraded_gcm
          assign f_tow = block.settings.towing
          if p != blank
            assign v = p.selected_or_first_available_variant
            assign vmf = v.metafields.custom
            assign vmfo = v.metafields.ori
            assign mf = p.metafields.custom
            assign mfo = p.metafields.ori
            assign f_gvm_old = vmf.original_gvm.value | default: vmfo.original_gvm.value | default: mf.original_gvm.value | default: mfo.original_gvm.value | default: f_gvm_old
            assign f_gvm_new = vmf.upgraded_gvm.value | default: vmfo.upgraded_gvm.value | default: mf.upgraded_gvm.value | default: mfo.upgraded_gvm.value | default: f_gvm_new
            assign f_gcm_old = vmf.original_gcm.value | default: vmfo.original_gcm.value | default: mf.original_gcm.value | default: mfo.original_gcm.value | default: f_gcm_old
            assign f_gcm_new = vmf.upgraded_gcm.value | default: vmfo.upgraded_gcm.value | default: mf.upgraded_gcm.value | default: mfo.upgraded_gcm.value | default: f_gcm_new
            assign f_tow = vmf.towing.value | default: vmfo.towing.value | default: mf.towing.value | default: mfo.towing.value | default: mf.braked_towing.value | default: mfo.braked_towing.value | default: f_tow
          endif
          assign link = block.settings.link | default: block.settings.collection.url | default: p.url
          assign quote_link = section.settings.ghost_link
          if quote_link == blank and link != blank and section.settings.ghost_anchor != blank
            assign quote_link = link | append: '#' | append: section.settings.ghost_anchor
          endif
          assign stage_lines = block.settings.stages | newline_to_br | split: '<br />'
        -%}
        <div
          class="ori-hgvm__panel"
          role="tabpanel"
          id="{{ uid }}-panel-{{ forloop.index }}"
          {% if vehicles.size > 1 %}aria-labelledby="{{ uid }}-tab-{{ forloop.index }}"{% endif %}
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div class="ori-hgvm__card">
            <div class="ori-hgvm__card-head">
              <h3 class="ori-hgvm__model">{{ block.settings.title | default: block.settings.name }}</h3>
              {%- if block.settings.years != blank -%}
                <span class="ori-hgvm__years">{{ block.settings.years }}</span>
              {%- endif -%}
            </div>
            <dl class="ori-figs ori-hgvm__figs">
              {%- if f_gvm_new != blank or f_gvm_old != blank -%}
                <div class="ori-fig">
                  <dt>GVM</dt>
                  <dd>
                    {%- if f_gvm_old != blank and f_gvm_new != blank and f_gvm_old != f_gvm_new -%}
                      <s>{{ f_gvm_old }}</s>
                    {%- endif -%}
                    {{- f_gvm_new | default: f_gvm_old -}}
                  </dd>
                </div>
              {%- endif -%}
              {%- if f_gcm_new != blank or f_gcm_old != blank -%}
                <div class="ori-fig">
                  <dt>GCM</dt>
                  <dd>
                    {%- if f_gcm_old != blank and f_gcm_new != blank and f_gcm_old != f_gcm_new -%}
                      <s>{{ f_gcm_old }}</s>
                    {%- endif -%}
                    {{- f_gcm_new | default: f_gcm_old -}}
                  </dd>
                </div>
              {%- endif -%}
              {%- if f_tow != blank -%}
                <div class="ori-fig"><dt>Towing</dt><dd>{{ f_tow }}</dd></div>
              {%- endif -%}
            </dl>
            {%- if block.settings.stages != blank -%}
              <div class="ori-hgvm__stage-wrap">
                {%- if section.settings.stages_label != blank -%}
                  <p class="ori-hgvm__stages-label">{{ section.settings.stages_label }}</p>
                {%- endif -%}
                <ol class="ori-hgvm__stages" role="list">
                  {%- for line in stage_lines -%}
                    {%- assign parts = line | strip_newlines | split: '|' -%}
                    {%- assign stage_name = parts[0] | strip -%}
                    {%- if stage_name != blank -%}
                      <li>
                        <b>{{ stage_name }}</b>
                        {%- if parts[1] != blank -%}{{ parts[1] | strip }}{%- endif -%}
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ol>
              </div>
            {%- endif -%}
            <div class="ori-hgvm__ctas">
              {%- if link != blank -%}
                <a class="ori-btn ori-btn--teal" href="{{ link }}">
                  {{- section.settings.button_prefix }} {{ block.settings.name }} {{ section.settings.button_suffix -}}
                </a>
              {%- endif -%}
              {%- if section.settings.ghost_label != blank and quote_link != blank -%}
                <a class="ori-btn ori-btn--ghost" href="{{ quote_link }}">{{ section.settings.ghost_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
      {%- if section.settings.note != blank -%}
        <p class="ori-hgvm__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>
<script src="{{ 'ori-home.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "ORI Home GVM upgrades",
  "settings": [
    { "type": "text", "id": "heading_1", "label": "Heading (teal)", "default": "GVM upgrades" },
    { "type": "text", "id": "heading_2", "label": "Heading (white)", "default": "that go on the plate" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Staged, federally approved packages that raise your legal carrying and towing limits — tested to ADR and certified, not just a spring swap."
    },
    { "type": "text", "id": "stages_label", "label": "Label above the stages", "default": "GVM by stage" },
    { "type": "text", "id": "button_prefix", "label": "Button text before vehicle name", "default": "View" },
    { "type": "text", "id": "button_suffix", "label": "Button text after vehicle name", "default": "packages" },
    { "type": "text", "id": "ghost_label", "label": "Second button label", "default": "Request a quote" },
    {
      "type": "text",
      "id": "ghost_anchor",
      "label": "Second button: anchor on the vehicle page",
      "default": "quote",
      "info": "Opens the vehicle's page at this anchor — the ORI GVM Quote section's Anchor ID."
    },
    {
      "type": "url",
      "id": "ghost_link",
      "label": "Second button: fixed link",
      "info": "Optional. Sends every vehicle to this one page instead."
    },
    { "type": "text", "id": "note", "label": "Fine print under the card" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "vehicle",
      "name": "Vehicle",
      "settings": [
        { "type": "text", "id": "name", "label": "Tab name", "default": "Silverado 1500" },
        { "type": "text", "id": "title", "label": "Full name", "default": "Chevrolet Silverado 1500" },
        { "type": "text", "id": "years", "label": "Years / trims" },
        {
          "type": "collection",
          "id": "collection",
          "label": "Vehicle GVM collection",
          "info": "The vehicle page both buttons open."
        },
        { "type": "url", "id": "link", "label": "Packages link override", "info": "Only if the button should go somewhere other than the collection." },
        {
          "type": "textarea",
          "id": "stages",
          "label": "Stages",
          "info": "One stage per line: name | GVM, e.g. Stage 1 | 3,650 kg. Copy from the collection's specification table."
        },
        {
          "type": "header",
          "content": "Figures"
        },
        {
          "type": "product",
          "id": "product",
          "label": "GVM product (figures from metafields)",
          "info": "Usually the top stage. Its GVM/GCM/towing metafields are used first; the fields below fill any gaps."
        },
        { "type": "text", "id": "original_gvm", "label": "Factory GVM", "placeholder": "3,300 kg" },
        { "type": "text", "id": "upgraded_gvm", "label": "Upgraded GVM (top stage)", "placeholder": "4,250 kg" },
        { "type": "text", "id": "original_gcm", "label": "Factory GCM", "placeholder": "7,160 kg" },
        { "type": "text", "id": "upgraded_gcm", "label": "Upgraded GCM (top stage)", "placeholder": "8,750 kg" },
        { "type": "text", "id": "towing", "label": "Braked towing", "placeholder": "4,500 kg" }
      ]
    }
  ],
  "presets": [{ "name": "ORI Home GVM upgrades" }]
}
{% endschema %}
