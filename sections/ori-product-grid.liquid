{%- comment -%}
  ORI redesign — product grid, built on snippets/ori-product-card.liquid.
  Uses the page's own collection on a collection template (so each GVM
  hub automatically shows its own kits), or the picked collection
  anywhere else. Prices are whatever Shopify resolves for the viewer —
  B2B catalog prices for company contacts — so nothing is calculated here.

  Button: "Request this kit" hands the product to the kit request form
  (assets/ori-gvm-kit-request.js) and only appears when that form is on
  the page; "Add to cart" is the normal shop behaviour.

  Vehicle filter (optional): add "Vehicle" blocks and the grid becomes one
  panel per vehicle with pill buttons to switch between them (GVM hub).
  Every panel is rendered here on page load and the pills only show/hide
  them (assets/ori-product-filter.js) — nothing is fetched afterwards, so
  B2B prices are always the viewer's own. Each vehicle can link to its
  GVM package page; #vehicle-<pill label> in the URL opens that vehicle.
  With no Vehicle blocks the section works as a single grid, as before.
{%- endcomment -%}
{{ 'gvm-css-main.css' | asset_url | stylesheet_tag }}
{%- render 'ori-fonts' -%}

{%- liquid
  assign custom_class = section.settings.custom_class
  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign source = collection
  if section.settings.collection != blank
    assign source = section.settings.collection
  endif
-%}
<div
  class="ori ori-section{{ custom_class }}"
  style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ori-wrap">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="ori-head">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="ori-h2">{{ section.settings.heading | newline_to_br }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="ori-head__intro">{{ section.settings.intro }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.view_all_label != blank and source.url != blank -%}
          <a class="ori-link" href="{{ source.url }}">{{ section.settings.view_all_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign vehicles = section.blocks | where: 'type', 'vehicle' -%}
    {%- if vehicles.size > 0 -%}
      <div class="ori-vfilter" data-ori-vfilter>
        <div class="ori-vfilter__bar">
          <div class="ori-vpills" role="tablist" aria-label="Filter by vehicle">
            {%- for block in vehicles -%}
              {%- assign vid = block.settings.label | default: block.settings.collection.title | handleize -%}
              <button
                type="button"
                class="ori-vpill"
                role="tab"
                id="ori-pill-{{ section.id }}-{{ forloop.index }}"
                aria-controls="vehicle-{{ vid }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                {% unless forloop.first %}tabindex="-1"{% endunless %}
                {{ block.shopify_attributes }}
              >
                {{- block.settings.label | default: block.settings.collection.title -}}
              </button>
            {%- endfor -%}
          </div>
        </div>

        {%- for block in vehicles -%}
          {%- liquid
            assign vid = block.settings.label | default: block.settings.collection.title | handleize
            assign vname = block.settings.label | default: block.settings.collection.title
            assign vlink_label = block.settings.link_label
            if vlink_label == blank
              assign vlink_label = 'View ' | append: vname | append: ' GVM packages'
            endif
          -%}
          <div
            class="ori-vpanel"
            id="vehicle-{{ vid }}"
            role="tabpanel"
            aria-labelledby="ori-pill-{{ section.id }}-{{ forloop.index }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            {%- if block.settings.link != blank -%}
              <a class="ori-vpanel__link ori-link" href="{{ block.settings.link }}">
                {{- vlink_label -}}
                {%- render 'ori-icon', icon: 'arrow' -%}
              </a>
            {%- endif -%}
            {%- if block.settings.collection == blank or block.settings.collection.products.size == 0 -%}
              <p class="ori-vpanel__empty">Kits for the {{ vname }} are coming soon.</p>
            {%- else -%}
              <div class="ori-grid">
                {%- for product in block.settings.collection.products -%}
                  {%- render 'ori-product-card',
                    product: product,
                    link: section.settings.show_links,
                    button: section.settings.button,
                    button_label: section.settings.button_label
                  -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <script src="{{ 'ori-product-filter.js' | asset_url }}" defer="defer"></script>
    {%- elsif source == blank or source.products.size == 0 -%}
      <p class="ori-head__intro">No products in this collection yet.</p>
    {%- else -%}
      <div class="ori-grid">
        {%- for product in source.products limit: section.settings.limit -%}
          {%- render 'ori-product-card',
            product: product,
            link: section.settings.show_links,
            button: section.settings.button,
            button_label: section.settings.button_label
          -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.fine_print != blank -%}
      <p class="ori-fine-print">{{ section.settings.fine_print }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "ORI Product Grid",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Line breaks are kept."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty on a collection page to show that collection. Ignored when Vehicle blocks are added."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products shown",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 24
    },
    {
      "type": "select",
      "id": "button",
      "label": "Card button",
      "options": [
        { "value": "request", "label": "Request this kit (GVM hub)" },
        { "value": "quote", "label": "Request quote (opens the ORI GVM Quote popup)" },
        { "value": "cart", "label": "Add to cart" },
        { "value": "link", "label": "View details (links to product)" },
        { "value": "none", "label": "None" }
      ],
      "default": "cart"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label override"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" link label",
      "info": "Links to the collection, next to the heading. Leave empty to hide."
    },
    {
      "type": "checkbox",
      "id": "show_links",
      "label": "Link cards to product pages",
      "default": true
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print under the grid"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class",
      "info": "Tab grouping, e.g. ori-panel ori-panel--2"
    }
  ],
  "blocks": [
    {
      "type": "vehicle",
      "name": "Vehicle",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "The kits shown for this vehicle — every product in it." },
        { "type": "text", "id": "label", "label": "Pill label", "info": "Short name on the filter pill, e.g. Silverado 1500. Defaults to the collection title." },
        { "type": "url", "id": "link", "label": "GVM package page", "info": "e.g. the vehicle's GVM collection page. Shown as a link above its grid." },
        { "type": "text", "id": "link_label", "label": "Link label", "info": "Defaults to \"View <pill label> GVM packages\"." }
      ]
    }
  ],
  "presets": [
    { "name": "ORI Product Grid" }
  ]
}
{% endschema %}
