{%- comment -%}
  GVM Packages Grid -- thin wrapper. All actual content (heading,
  titles, text, links) lives in snippets/gvm-packages-grid-content.liquid
  so it's shared/synced across every page using this section --
  editing that one snippet updates every page at once.

  Images are the one exception (see the snippet's own comment for
  why) -- kept as settings here and passed through as parameters.
{%- endcomment -%}

{{ 'gvm-css-main.css' | asset_url | stylesheet_tag }}

<div class="gvm-packages-grid f-section-padding" style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- render 'gvm-packages-grid-content',
      image_f150: section.settings.image_f150,
      image_tundra: section.settings.image_tundra,
      image_silverado1500: section.settings.image_silverado1500,
      image_silverado2500: section.settings.image_silverado2500
    -%}
  </div>
</div>

{% schema %}
{
  "name": "GVM Packages Grid",
  "settings": [
    { "type": "image_picker", "id": "image_f150", "label": "Ford F150 image" },
    { "type": "image_picker", "id": "image_tundra", "label": "Toyota Tundra image" },
    { "type": "image_picker", "id": "image_silverado1500", "label": "Chevy Silverado 1500 image" },
    { "type": "image_picker", "id": "image_silverado2500", "label": "Chevy Silverado 2500HD image" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "presets": [
    { "name": "GVM Packages Grid" }
  ]
}
{% endschema %}
