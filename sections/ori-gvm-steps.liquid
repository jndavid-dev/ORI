{%- comment -%}
  ORI GVM Installation Process — ORI redesign.
  Numbered step cards joined by a teal line, in the same design as the hub's
  "How ordering works" (styles shared with sections/ori-steps.liquid). Numbers
  follow block order, so adding or reordering steps renumbers them. Three
  across on desktop, stacked with vertical connectors on tablet and mobile.
  Same settings and step blocks as before; "Use tinted background" gives the
  light band, otherwise the dark one.
{%- endcomment -%}
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign steps = section.blocks | where: 'type', 'step'
-%}
{%- if steps.size > 0 -%}
  <div
    id="{{ section_id }}"
    class="ori ori-section ori-steps ori-steps--{% if section.settings.alt_background %}light{% else %}dark{% endif %}"
    data-section-type="ori-gvm-steps"
    style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="ori-wrap">
      {%- if section.settings.heading != blank -%}
        <div class="ori-head ori-head--{{ section.settings.heading_align | default: 'center' }}">
          <div><h2 class="ori-h2">{{ section.settings.heading }}</h2></div>
        </div>
      {%- endif -%}
      <ol class="ori-steps__list" style="--ori-n: {{ steps.size }};">
        {%- for block in steps -%}
          <li class="ori-step" {{ block.shopify_attributes }}>
            <div class="ori-step__top">
              <span class="ori-step__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            </div>
            {%- if block.settings.heading != blank -%}
              <h3 class="ori-step__title">
                <span class="ori-sr">Step {{ forloop.index }}: </span>
                {{- block.settings.heading -}}
              </h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="ori-step__text"><p>{{ block.settings.text }}</p></div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ORI GVM Install Steps",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Installation process" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "center", "label": "Centred" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Layout style" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "info": "Match this to the ORI GVM Product section on the same page.",
      "options": [
        { "value": "classic", "label": "Classic (light, centred)" },
        { "value": "editorial", "label": "Technical (engineering plate)" }
      ],
      "default": "classic"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Number circle size",
      "info": "Steps sit side by side on desktop and stack into one centred column on mobile. Three to five steps read best in a row.",
      "min": 36,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 54
    },
    { "type": "header", "content": "Appearance" },
    { "type": "checkbox", "id": "alt_background", "label": "Use tinted background", "info": "Ignored on the Technical layout, which gives the steps their own paper tone.", "default": false },
    { "type": "color", "id": "tint_color", "label": "Tint colour", "default": "#f3f6f7" },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container", "label": "Fixed (1200px)" },
        { "value": "container-narrow", "label": "Narrow" },
        { "value": "container-full", "label": "Full width" }
      ],
      "default": "container"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "text", "id": "custom_id", "label": "Custom HTML ID" },
    { "type": "text", "id": "color_schema", "label": "Color scheme class" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Installation step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Step heading", "default": "Book your install" },
        { "type": "textarea", "id": "text", "label": "Step description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORI GVM Install Steps",
      "blocks": [
        { "type": "step", "settings": { "heading": "Request quote", "text": "Send us your vehicle details and we prepare a package quote." } },
        { "type": "step", "settings": { "heading": "Book your install", "text": "Choose an approved installer near you and book a date." } },
        { "type": "step", "settings": { "heading": "Get certified", "text": "We complete the upgrade and issue engineering certification." } }
      ]
    }
  ]
}
{% endschema %}
