{%- comment -%}
  ORI GVM Key Benefits — ORI redesign.
  A row of cards, each with an icon in a teal circle, a condensed uppercase
  title and supporting copy (line breaks kept). Three across on desktop, two
  on tablet, one on mobile; cards stretch to equal height. Icons come from
  the shared ori-gvm-icon snippet, so this section and What's Included draw
  on one set. Same settings and benefit blocks as before; "Use tinted
  background" now gives the pale bone band.
{%- endcomment -%}
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id
  assign benefits = section.blocks | where: 'type', 'benefit'
-%}
{%- if benefits.size > 0 -%}
  <div
    id="{{ section_id }}"
    class="ori ori-section ori-benefits{% if section.settings.alt_background %} ori-benefits--alt{% endif %}"
    data-section-type="ori-gvm-benefits"
    style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="ori-wrap">
      {%- if section.settings.heading != blank -%}
        <div class="ori-head ori-head--{{ section.settings.heading_align | default: 'left' }}">
          <div><h2 class="ori-h2">{{ section.settings.heading }}</h2></div>
        </div>
      {%- endif -%}
      <ul class="ori-benefits__list" style="--ori-cols: {{ section.settings.cards_per_row | default: 3 }};" role="list">
        {%- for block in benefits -%}
          <li class="ori-benefit" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' and block.settings.icon != blank -%}
              <span class="ori-benefit__icon" aria-hidden="true">
                {%- render 'ori-gvm-icon', icon: block.settings.icon, class: 'ori-benefit__svg', stroke: 1.6 -%}
              </span>
            {%- endif -%}
            <h3 class="ori-benefit__title">{{ block.settings.text }}</h3>
            {%- if block.settings.note != blank -%}
              {%- comment -%}
                Each line is a paragraph (blank lines just separate them). A
                short label before a colon at the start of a line, e.g.
                "BDS Suspension: …" or a line that is only "Peace of Mind:",
                is set in bold so long notes stay scannable.
              {%- endcomment -%}
              <div class="ori-benefit__note">
                {%- assign note_lines = block.settings.note | newline_to_br | split: '<br />' -%}
                {%- for raw in note_lines -%}
                  {%- assign line = raw | strip -%}
                  {%- if line == blank -%}{%- continue -%}{%- endif -%}
                  {%- liquid
                    assign lead = line | split: ':' | first
                    assign rest = line | remove_first: lead | remove_first: ':' | strip
                    assign is_label = false
                    if line contains ':' and lead.size <= 40
                      assign is_label = true
                      if lead contains '.'
                        assign is_label = false
                      endif
                    endif
                  -%}
                  {%- if is_label -%}
                    <p><strong>{{ lead | escape }}:</strong>{% if rest != blank %} {{ rest | escape }}{% endif %}</p>
                  {%- else -%}
                    <p>{{ line | escape }}</p>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "ORI GVM Key Benefits",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Key benefits" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Layout style" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "info": "Match this to the ORI GVM Product section on the same page.",
      "options": [
        { "value": "classic", "label": "Classic (light, centred)" },
        { "value": "editorial", "label": "Technical (engineering plate)" }
      ],
      "default": "classic"
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "label": "Cards per row (desktop)",
      "info": "Drops to two on tablet and one on mobile whatever this is set to.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "header", "content": "Appearance" },
    { "type": "checkbox", "id": "alt_background", "label": "Use tinted background", "default": true },
    { "type": "color", "id": "tint_color", "label": "Tint colour", "default": "#f3f6f7" },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container", "label": "Fixed (1200px)" },
        { "value": "container-narrow", "label": "Narrow" },
        { "value": "container-full", "label": "Full width" }
      ],
      "default": "container"
    },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "text", "id": "custom_id", "label": "Custom HTML ID" },
    { "type": "text", "id": "color_schema", "label": "Color scheme class" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Key benefit",
      "settings": [
        { "type": "text", "id": "text", "label": "Benefit", "default": "Increased legal payload" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "No icon" },
            { "value": "weight", "label": "Weight" },
            { "value": "suspension", "label": "Suspension" },
            { "value": "seal", "label": "Approval seal" },
            { "value": "shield", "label": "Shield" },
            { "value": "certificate", "label": "Certificate" },
            { "value": "wrench", "label": "Wrench" },
            { "value": "cog", "label": "Cog" },
            { "value": "truck", "label": "Truck" },
            { "value": "check", "label": "Tick" }
          ],
          "default": "check"
        },
        { "type": "textarea", "id": "note", "label": "Description", "info": "Optional supporting copy under the benefit." }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORI GVM Key Benefits",
      "blocks": [
        { "type": "benefit", "settings": { "text": "Increased legal payload capacity", "icon": "weight" } },
        { "type": "benefit", "settings": { "text": "Upgraded Fox / BDS suspension", "icon": "suspension" } },
        { "type": "benefit", "settings": { "text": "Federal engineering approval", "icon": "seal" } }
      ]
    }
  ]
}
{% endschema %}
