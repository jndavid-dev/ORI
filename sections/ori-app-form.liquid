{%- comment -%}
  ORI redesign — app form. Wraps an app block (Shopify Forms, etc.) in the
  ORI layout: eyebrow, heading, intro and a list of points on the left, the
  form in a white card on the right. Stacks on tablet and mobile with the
  card under the copy. Optional login line under the points for visitors
  who already have an account.

  App forms render their own markup, so colours inside the form come from
  the app block's own settings (match them to the ORI palette in the editor).
{%- endcomment -%}
{%- assign points = section.blocks | where: 'type', 'point' -%}
<div
  class="ori ori-section ori-appform{% if section.settings.dark %} ori-appform--dark{% endif %}"
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ori-wrap ori-appform__grid">
    <div class="ori-appform__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ori-appform__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ori-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <div class="ori-appform__intro">{{ section.settings.intro }}</div>
      {%- endif -%}

      {%- if points.size > 0 -%}
        <ul class="ori-appform__points" role="list">
          {%- for block in points -%}
            <li class="ori-appform__point" {{ block.shopify_attributes }}>
              <span class="ori-appform__icon" aria-hidden="true">
                {%- render 'ori-icon', icon: block.settings.icon -%}
              </span>
              <div>
                <h3 class="ori-appform__point-title">{{ block.settings.heading }}</h3>
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.login_text != blank and section.settings.login_label != blank -%}
        <p class="ori-appform__login">
          {{ section.settings.login_text }}
          <a href="{{ section.settings.login_url | default: routes.account_login_url }}">
            {{- section.settings.login_label -}}
          </a>
        </p>
      {%- endif -%}
    </div>

    <div class="ori-appform__card">
      {%- if section.settings.card_heading != blank -%}
        <h3 class="ori-appform__card-title">{{ section.settings.card_heading }}</h3>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          {% render block %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "ORI App form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trade accounts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Apply for wholesale access" },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "card_heading", "label": "Form heading" },
    { "type": "header", "content": "Login line" },
    { "type": "text", "id": "login_text", "label": "Text", "default": "Already an approved partner?" },
    { "type": "text", "id": "login_label", "label": "Link label", "default": "Log in" },
    { "type": "url", "id": "login_url", "label": "Link", "info": "Leave empty to use the customer login page." },
    { "type": "header", "content": "Layout" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Lets buttons link here, e.g. apply → #apply." },
    { "type": "checkbox", "id": "dark", "label": "Dark band", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Approval (shield)" },
            { "value": "award", "label": "Specialist (award)" },
            { "value": "warehouse", "label": "Stock (warehouse)" },
            { "value": "network", "label": "Installer network (map pin)" },
            { "value": "headset", "label": "Support (headset)" },
            { "value": "clipboard", "label": "Checklist" },
            { "value": "truck", "label": "Truck" },
            { "value": "suspension", "label": "Suspension" },
            { "value": "tow", "label": "Towing / GCM" },
            { "value": "tyre", "label": "Tyre" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Point" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "ORI App form" }]
}
{% endschema %}
