{%- comment -%}
  ORI redesign — Hero banner. Full-bleed dark banner with the copy built in
  HTML rather than baked into an image, so headings stay crisp, readable
  by search engines and editable here.

  Three looks (Style setting):
  - Vehicle cut-out: a transparent PNG/WebP of the vehicle over a ridge
    line — the GVM vehicle hubs.
  - Photo: a full photo on the right, faded into the dark — home page.
  - Simple: no image, centred copy over the ridge line — landing pages
    like the GVM hub. The default for new hero sections.

  Blocks: brand logos, feature points (icon + text) and up to two buttons.
  Button links that start with # (e.g. #tab-4) open that hub tab.
  The banner markup lives in snippets/ori-hero-slide.liquid, shared with
  sections/ori-hero-slider.liquid.
{%- endcomment -%}

{%- liquid
  assign logos = section.blocks | where: 'type', 'logo'
  assign feats = section.blocks | where: 'type', 'feature'
  assign buttons = section.blocks | where: 'type', 'button'
  assign heading_tag = section.settings.heading_tag | default: 'h1'
-%}

{%- capture logos_html -%}
  {%- for block in logos -%}
    {%- if block.settings.image != blank -%}
      {{
        block.settings.image
        | image_url: width: 120
        | image_tag: width: 58, height: 58, alt: block.settings.alt, loading: 'eager'
      }}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture feats_html -%}
  {%- for block in feats -%}
    <li class="ori-feat" {{ block.shopify_attributes }}>
      {%- render 'ori-icon', icon: block.settings.icon -%}
      <span>{{ block.settings.text | newline_to_br }}</span>
    </li>
  {%- endfor -%}
{%- endcapture -%}

{%- capture ctas_html -%}
  {%- for block in buttons limit: 2 -%}
    {%- if block.settings.label != blank -%}
      {%- if block.settings.popup_id != blank -%}
        {%- comment -%}
          Opens a popup section (e.g. ORI GVM Quote) with this ID through
          the theme modal-opener, which binds to the first <button> inside.
        {%- endcomment -%}
        <modal-opener class="ori-hero__opener" data-modal="#PopupModal-{{ block.settings.popup_id | handle }}" {{ block.shopify_attributes }}>
          <button type="button" class="ori-btn ori-btn--{{ block.settings.style }}" aria-haspopup="dialog">
            {{- block.settings.label -}}
          </button>
        </modal-opener>
      {%- else -%}
        <a
          class="ori-btn ori-btn--{{ block.settings.style }}"
          href="{{ block.settings.link | default: '#' }}"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.label -}}
        </a>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- render 'ori-hero-slide',
  s: section.settings,
  logos_html: logos_html,
  feats_html: feats_html,
  ctas_html: ctas_html,
  heading_tag: heading_tag,
  eager: true
-%}

{% schema %}
{
  "name": "ORI Hero",
  "tag": "section",
  "class": "ori-hero-section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "cutout", "label": "Vehicle cut-out (transparent image)" },
        { "value": "photo", "label": "Photo, faded in from the right" },
        { "value": "plain", "label": "Simple (no image)" }
      ],
      "default": "plain"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Cut-out: transparent PNG/WebP of the vehicle, around 1600px wide. Photo: landscape, 2000px wide."
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Fallback image (theme asset file name)",
      "info": "Used when no image is picked above, e.g. ori-hero-chevy-2500-cutout.webp."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Fallback image alt text"
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Cut-out width (desktop)",
      "info": "Share of the screen width the cut-out may use. Wider suits group shots of several vehicles.",
      "min": 35,
      "max": 65,
      "step": 1,
      "unit": "%",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "media_flush",
      "label": "Sit image on the bottom edge",
      "info": "For cut-outs cropped at the bottom (wheels cut off): the image meets the hero's bottom edge with no ground shadow.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "feats_one_row",
      "label": "Feature points in one row on desktop",
      "info": "Keeps the feature points on a single row from 1360px wide, for a shorter banner. Below that they stack two per row.",
      "default": false
    },
    {
      "type": "select",
      "id": "size",
      "label": "Banner size (desktop)",
      "info": "Large: a bigger heading and vehicle with less side space — for the home page.",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "large", "label": "Large" }
      ],
      "default": "standard"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge above the heading",
      "info": "e.g. Federally Approved | ADR-Tested | SSM Certified"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Line 1",
      "default": "Chevrolet Silverado"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Line 2",
      "default": "1500 LTZ & ZR2"
    },
    {
      "type": "textarea",
      "id": "pill",
      "label": "Pill next to line 2",
      "info": "Line breaks are kept.",
      "default": "GVM & GCM packages\n4250kg & 8750kg"
    },
    {
      "type": "checkbox",
      "id": "heading_2_white",
      "label": "Line 2 in white",
      "default": false
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Text under the heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Use H1 unless another section on the page already has the page's H1.",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "text_link_label",
      "label": "Text link under the buttons",
      "info": "e.g. Know your weight? Try the GVM calculator. Needs a URL below."
    },
    {
      "type": "url",
      "id": "text_link_url",
      "label": "Text link URL"
    },
    {
      "type": "header",
      "content": "Plate badge (top right)"
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge",
      "default": "NB1"
    },
    {
      "type": "text",
      "id": "badge_small",
      "label": "Badge small text",
      "default": "Car licence"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand logo",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "alt", "label": "Brand name (for screen readers)" }
      ]
    },
    {
      "type": "feature",
      "name": "Feature point",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield (approval)" },
            { "value": "suspension", "label": "Suspension" },
            { "value": "clipboard", "label": "Checklist" },
            { "value": "tyre", "label": "Tyre" },
            { "value": "award", "label": "Award" },
            { "value": "network", "label": "Installer network (map pin)" },
            { "value": "truck", "label": "Truck" },
            { "value": "tow", "label": "Towing / GCM" }
          ],
          "default": "shield"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "info": "Line breaks are kept."
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "link", "label": "Link", "info": "A URL like /collections/all, or on a GVM hub #tab-1 to #tab-4 to open that tab." },
        { "type": "text", "id": "popup_id", "label": "Popup ID", "info": "Opens the popup section with this ID instead of following the link, e.g. ori-gvm-quote for the ORI GVM Quote popup." },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "teal", "label": "Solid teal" },
            { "value": "ghost", "label": "White outline" }
          ],
          "default": "teal"
        }
      ]
    }
  ],
  "presets": [
    { "name": "ORI Hero" }
  ]
}
{% endschema %}
