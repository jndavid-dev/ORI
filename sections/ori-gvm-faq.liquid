{%- comment -%}
  ORI redesign — FAQ (GVM hub). Separate from sections/ori-faq.liquid,
  which 13 older templates still use with their own blocks. Heading and intro (with an optional contact button)
  on the left, accordion questions on the right; stacked on tablet and
  mobile. Native <details> elements, so it opens and closes without
  JavaScript and stays readable to search engines. The same questions are
  also output as FAQPage structured data (JSON-LD).
{%- endcomment -%}
{%- assign faqs = section.blocks | where: 'type', 'question' -%}
<div
  class="ori ori-section ori-gfaq"
  style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ori-wrap ori-gfaq__grid">
    <div class="ori-gfaq__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="ori-h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="ori-head__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="ori-btn ori-btn--teal" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
    <div class="ori-gfaq__list">
      {%- for block in faqs -%}
        <details class="ori-gfaq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="ori-gfaq__q">
            <span>{{ block.settings.question }}</span>
            <span class="ori-gfaq__icon" aria-hidden="true"></span>
          </summary>
          <div class="ori-gfaq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- if faqs.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in faqs -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "ORI FAQ (redesign)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is a GVM upgrade?" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "ORI FAQ (redesign)" }]
}
{% endschema %}
