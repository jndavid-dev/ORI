{%- comment -%}
  ORI Installer network — ORI redesign.
  Approved GVM installers grouped by state: pill tabs (with a count each)
  over a grid of installer cards. Platinum installers get a teal top rule
  and badge. Three cards across on desktop, two on tablet, one on mobile.

  This section is also copied into GVM product pages by
  sections/ori-gvm-approved.liquid (assets/ori-gvm-approved.js lifts it by
  [data-section-type="ori-installer-network"] and re-runs the inline tab
  script), so the data-section-type attribute and the tab wiring must stay.
  Styles: ORI REDESIGN — INSTALLER NETWORK in assets/gvm-css-main.css.

  Rows whose name still reads like a placeholder ("to be added", "TBC" …)
  are skipped, so unfinished data never reaches the storefront.
{%- endcomment -%}
{{ 'gvm-css-main.css' | asset_url | stylesheet_tag }}
{%- render 'ori-fonts' -%}
{%- liquid
  assign section_id = section.settings.custom_id | default: section.id

  # ACT is in the list because the dealer network has a Queanbeyan installer;
  # a state missing here silently drops every installer assigned to it.
  assign states = 'VIC,NSW,QLD,WA,SA,TAS,ACT,NT' | split: ','
  assign placeholder_terms = 'add via theme editor,to be added,to be confirmed,tbc,tba,coming soon,placeholder,name tbc,xxxx' | split: ','

  # One pass: which states have real installers, and how many each.
  assign active_states = ''
  assign state_counts = ''
  for state in states
    assign n = 0
    for block in section.blocks
      if block.type != 'installer' or block.settings.state != state or block.settings.name == blank
        continue
      endif
      assign nl = block.settings.name | downcase
      assign is_placeholder = false
      for term in placeholder_terms
        if nl contains term
          assign is_placeholder = true
          break
        endif
      endfor
      unless is_placeholder
        assign n = n | plus: 1
      endunless
    endfor
    if n > 0
      assign active_states = active_states | append: ',' | append: state
      assign state_counts = state_counts | append: ',' | append: n
    endif
  endfor
  assign active_states_arr = active_states | remove_first: ',' | split: ','
  assign state_counts_arr = state_counts | remove_first: ',' | split: ','

  assign cta_class = 'ori-btn--line'
  if section.settings.cta_style == 'btn--primary'
    assign cta_class = 'ori-btn--teal'
  endif
-%}

<div
  id="{{ section_id }}"
  class="ori ori-section ori-inet{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  data-section-type="ori-installer-network"
  style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ori-wrap">
    {%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.cta_text != blank -%}
      <div class="ori-head">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="ori-h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="ori-head__intro">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.cta_text != blank and section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="ori-btn {{ cta_class }}">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if active_states_arr.size > 0 -%}
      <div class="ori-inet__tabs" data-installer-tabs>
        <div class="ori-inet__tab-nav" role="tablist" aria-label="Choose a state">
          {%- for state in active_states_arr -%}
            <button
              type="button"
              class="ori-inet__tab{% if forloop.first %} is-active{% endif %}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="installer-panel-{{ state | downcase }}-{{ section.id }}"
              id="installer-tab-{{ state | downcase }}-{{ section.id }}"
              data-state="{{ state }}"
              {% unless forloop.first %}tabindex="-1"{% endunless %}
            >
              {{ state }}
              <span class="ori-inet__count">{{ state_counts_arr[forloop.index0] }}</span>
            </button>
          {%- endfor -%}
        </div>

        {%- for state in active_states_arr -%}
          <div
            class="ori-inet__panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            id="installer-panel-{{ state | downcase }}-{{ section.id }}"
            aria-labelledby="installer-tab-{{ state | downcase }}-{{ section.id }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <ul class="ori-inet__grid" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type != 'installer' or block.settings.state != state or block.settings.name == blank -%}
                  {%- continue -%}
                {%- endif -%}
                {%- liquid
                  assign nl = block.settings.name | downcase
                  assign is_placeholder = false
                  for term in placeholder_terms
                    if nl contains term
                      assign is_placeholder = true
                      break
                    endif
                  endfor
                -%}
                {%- if is_placeholder -%}{%- continue -%}{%- endif -%}
                <li class="ori-inet__card{% if block.settings.platinum %} ori-inet__card--platinum{% endif %}" {{ block.shopify_attributes }}>
                  <div class="ori-inet__card-head">
                    <div>
                      {%- if block.settings.platinum -%}
                        <span class="ori-inet__badge">Platinum GVM installer</span>
                      {%- endif -%}
                      <h3 class="ori-inet__name">{{ block.settings.name }}</h3>
                    </div>
                    {%- if block.settings.logo != blank -%}
                      <span class="ori-inet__logo">
                        {{-
                          block.settings.logo
                          | image_url: width: 200
                          | image_tag:
                            loading: 'lazy',
                            widths: '100, 150, 200',
                            sizes: '96px',
                            alt: block.settings.name
                        -}}
                      </span>
                    {%- endif -%}
                  </div>

                  <div class="ori-inet__info">
                    {%- if block.settings.address != blank or block.settings.suburb != blank -%}
                      <p class="ori-inet__row">
                        {%- render 'icon-map-pin' -%}
                        <span>
                          {%- if block.settings.address != blank -%}{{ block.settings.address }}<br>{%- endif -%}
                          {{- block.settings.suburb -}}
                          {%- if block.settings.state != blank -%}, {{ block.settings.state }}{%- endif -%}
                          {%- if block.settings.postcode != blank %} {{ block.settings.postcode }}{% endif -%}
                        </span>
                      </p>
                    {%- endif -%}
                    {%- assign pl = block.settings.phone | downcase -%}
                    {%- if block.settings.phone != blank -%}
                      {%- unless pl contains 'tbc' or pl contains 'xxxx' or pl contains 'coming' -%}
                        <a href="tel:{{ block.settings.phone | remove: ' ' }}" class="ori-inet__row ori-inet__row--link">
                          {%- render 'icon-phone' -%}
                          <span>{{ block.settings.phone }}</span>
                        </a>
                      {%- endunless -%}
                    {%- endif -%}
                    {%- if block.settings.email != blank -%}
                      <a href="mailto:{{ block.settings.email }}" class="ori-inet__row ori-inet__row--link ori-inet__email">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                        <span>{{ block.settings.email }}</span>
                      </a>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.website != blank -%}
                    <a href="{{ block.settings.website }}" class="ori-link ori-inet__web" target="_blank" rel="noopener">
                      Visit website<span class="ori-sr"> for {{ block.settings.name }} (opens in a new tab)</span>
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="ori-inet__empty">Installer locations coming soon.</p>
    {%- endif -%}
  </div>

  <script>
    (function () {
      document.querySelectorAll('[data-installer-tabs]').forEach(function (tabs) {
        if (tabs.dataset.ready) return;
        tabs.dataset.ready = '1';
        var btns = Array.prototype.slice.call(tabs.querySelectorAll('[role="tab"]'));
        function select(btn, focus) {
          btns.forEach(function (b) {
            var on = b === btn;
            b.classList.toggle('is-active', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
            b.tabIndex = on ? 0 : -1;
            var panel = document.getElementById(b.getAttribute('aria-controls'));
            if (panel) {
              panel.classList.toggle('is-active', on);
              panel.hidden = !on;
            }
          });
          if (focus) btn.focus();
        }
        btns.forEach(function (btn, i) {
          btn.addEventListener('click', function () { select(btn); });
          btn.addEventListener('keydown', function (e) {
            var step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
            if (!step) return;
            e.preventDefault();
            select(btns[(i + step + btns.length) % btns.length], true);
          });
        });
      });
    })();
  </script>
</div>

{% schema %}
{
  "name": "ORI Installer Network",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Approved Installer Network"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "ORI GVM and GCM packages are installed by our certified specialists across every state and territory."
    },
    {
      "type": "header",
      "content": "Footer CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button URL"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA button style",
      "options": [
        { "value": "btn--primary", "label": "Primary" },
        { "value": "btn--secondary", "label": "Secondary" },
        { "value": "btn--outline", "label": "Outline" }
      ],
      "default": "btn--outline"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container width",
      "options": [
        { "value": "container-full", "label": "Full width" },
        { "value": "container", "label": "Fixed (1200px)" },
        { "value": "container-narrow", "label": "Narrow" }
      ],
      "default": "container"
    },
    {
      "type": "select",
      "id": "color_schema",
      "label": "Color scheme",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "accent", "label": "Accent" },
        { "value": "inverse", "label": "Inverse" }
      ],
      "default": ""
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "info": "Optional. Leave blank to inherit the page background."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom HTML ID"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    }
  ],
  "blocks": [
    {
      "type": "installer",
      "name": "Installer",
      "settings": [
        {
          "type": "select",
          "id": "state",
          "label": "State / Territory",
          "options": [
            { "value": "VIC", "label": "Victoria (VIC)" },
            { "value": "NSW", "label": "New South Wales (NSW)" },
            { "value": "QLD", "label": "Queensland (QLD)" },
            { "value": "WA",  "label": "Western Australia (WA)" },
            { "value": "SA",  "label": "South Australia (SA)" },
            { "value": "TAS", "label": "Tasmania (TAS)" },
            { "value": "ACT", "label": "Aust. Capital Territory (ACT)" },
            { "value": "NT",  "label": "Northern Territory (NT)" }
          ],
          "default": "VIC"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Business name",
          "default": "ORI Approved Installer"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Optional. Shown top-right of the card."
        },
        {
          "type": "checkbox",
          "id": "platinum",
          "label": "Platinum GVM Installer",
          "default": false
        },
        {
          "type": "text",
          "id": "address",
          "label": "Street address"
        },
        {
          "type": "text",
          "id": "suburb",
          "label": "Suburb / City",
          "default": "Melbourne"
        },
        {
          "type": "text",
          "id": "postcode",
          "label": "Postcode"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone number"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email address"
        },
        {
          "type": "url",
          "id": "website",
          "label": "Website URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ORI Installer Network",
      "blocks": [
        {
          "type": "installer",
          "settings": {
            "state": "VIC",
            "name": "ORI Offroad Industries (HQ)",
            "suburb": "Melbourne",
            "phone": "03 XXXX XXXX"
          }
        },
        {
          "type": "installer",
          "settings": {
            "state": "NSW",
            "name": "NSW Installer — Name TBC",
            "suburb": "Sydney"
          }
        },
        {
          "type": "installer",
          "settings": {
            "state": "QLD",
            "name": "QLD Installer — Name TBC",
            "suburb": "Brisbane"
          }
        }
      ]
    }
  ]
}
{% endschema %}
