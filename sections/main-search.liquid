{%- comment -%}
  ORI redesign — search results. Same build as the ORI collection grid
  (sections/ori-collection-grid.liquid), so search gets the working filter
  sidebar (the store's search filters: availability and price, plus any
  added in the Search & Discovery app), the sort bar, the ORI product cards
  and the ORI pagination styles; facets.js and product-grid-container.js
  drive them through the same ids (#ProductGridContainer, #product-grid).
  Header: an ORI band with the query, result count and the search field
  (predictive search markup kept). Articles and pages in the results show
  as simple ORI cards after the products. Styles: "ORI REDESIGN — SEARCH"
  in gvm-css-main.css.
{%- endcomment -%}
{%- liquid
  assign limit = section.settings.limit
  assign container = section.settings.container
  assign columns = section.settings.columns

  assign enable_filtering = section.settings.enable_filtering
  assign enable_sorting = section.settings.enable_sorting
  assign enable_product_count = section.settings.enable_product_count
  assign sidebar_position = section.settings.sidebar_position

  comment
    snippets/facets.liquid only shows the Brand (vendor) filter on search.
    The sidebar shows when that filter exists (live: Search & Discovery);
    otherwise it is dropped and the grid uses the full width (staging).
  endcomment
  assign show_sidebar = false
  if enable_filtering
    for filter in search.filters
      assign label_lc = filter.label | downcase
      if filter.param_name == 'filter.p.vendor' or label_lc == 'brand' or label_lc == 'vendor'
        assign show_sidebar = true
      endif
    endfor
  endif
  assign columns_lg = columns
  if show_sidebar and sidebar_position != 'drawer'
    assign columns_lg = columns | at_most: 3
  endif

  assign predictive_search_enabled = settings.predictive_search_enabled
  assign animation_effect = settings.animations
-%}
{{ 'search.css' | asset_url | stylesheet_tag }}
{{ 'search-drawer.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
<link
  id="ModalComponent"
  rel="stylesheet"
  href="{{ 'modal-component.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>
{% if enable_filtering or enable_sorting %}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{% endif %}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-grid-container.js' | asset_url }}" defer="defer"></script>

<div
  class="f-template-search ori-search{% unless search.performed and search.results_count > 0 %} f-template-search--empty{% endunless %}"
>
  <div class="ori ori-shead">
    <div class="ori-wrap ori-shead__in">
      {%- if search.performed -%}
        <p class="ori-shead__eyebrow">{{ 'templates.search.title' | t }}</p>
        <h1 class="ori-shead__title">
          {%- if search.terms != blank -%}&ldquo;{{ search.terms | escape }}&rdquo;{%- else -%}{{ 'general.search.search' | t }}{%- endif -%}
        </h1>
        {%- comment -%} The count shows once, in the sort bar below, which also updates with filters. {%- endcomment -%}
      {%- else -%}
        <h1 class="ori-shead__title">{{ 'general.search.search' | t }}</h1>
        <p class="ori-shead__count">Search parts, brands, vehicles and GVM packages.</p>
      {%- endif -%}
      <div class="f-template-search__search ori-shead__search">
      {%- if predictive_search_enabled -%}
        <predictive-search class="h-full" data-loading-text="{{ 'accessibility.loading' | t }}">
      {%- endif -%}
      <main-search>
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="f-search-drawer__form h-full flex flex-col"
        >
          <div class="f-template-search__field w-full">
            <label class="visually-hidden" for="f-search-drawer-input">{{ 'general.search.search' | t }}</label>
            <input
              class="form-control focus-none f-search-drawer__input"
              id="f-search-drawer-input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.placeholder' | t }}"
              data-drawer-focus
              {% if predictive_search_enabled %}
                role="combobox"
                aria-expanded="false"
                aria-owns="f-predictive-search-results"
                aria-controls="f-predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
                data-predictive-search-input
              {% endif %}
            >
            <button type="submit" class="btn btn--plain" aria-label="{{ 'general.search.search' | t }}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
                focusable="false"
                role="presentation"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="f-icon-svg f-icon-svg--medium  f-icon-search"
              >
                <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
            <input type="hidden" name="options[prefix]" value="last">
            <input type="hidden" name="options[unavailable_products]" value="show">
          </div>
          {%- if predictive_search_enabled -%}
            <div class="f-predictive-search" tabindex="-1" data-predictive-search>
              <div class="f-predictive-search__loading-state">
                {% comment %} theme-check-disable {% endcomment %}
                {{ 'icon-spinner.svg' | inline_asset_content }}
                {% comment %} theme-check-enable {% endcomment %}
              </div>
            </div>
            <span class="visually-hidden" role="status" aria-hidden="true" data-predictive-search-status></span>
          {%- endif -%}
        </form>
      </main-search>
      {%- if predictive_search_enabled -%}
        </predictive-search>
      {%- endif -%}
      </div>
    </div>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count == 0 and search.filters == empty -%}
      <div class="ori ori-section ori-search__none">
        <div class="ori-wrap">
          <h2 class="ori-search__none-title">No results for &ldquo;{{ search.terms | escape }}&rdquo;</h2>
          <p>Check the spelling, try a part number or brand, or browse by vehicle.</p>
          <div class="ori-search__none-actions">
            <a class="ori-btn ori-btn--teal" href="{{ routes.all_products_collection_url }}">Browse all parts</a>
            <a class="ori-btn ori-search__btn-line" href="/pages/ori-gvm-upgrades">GVM &amp; GCM upgrades</a>
          </div>
        </div>
      </div>
    {%- else -%}
      <div
        id="ProductGridContainer"
        data-section-id="{{ section.id }}"
        class="main-collection ori-cgrid block f-section-padding"
        style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px; --ori-cols: {{ columns }}; --ori-cols-lg: {{ columns_lg }};"
      >
        <div class="main-collection__container">
          {%- paginate search.results by limit -%}
            {%- liquid
              assign products_list = search.results | where: 'object_type', 'product'
              assign articles_list = search.results | where: 'object_type', 'article'
              assign pages_list = search.results | where: 'object_type', 'page'
            -%}
            <div class="{{ container }}">
              <div class="main-collection__wrapper main-collection__wrapper--{{ sidebar_position }} flex{% unless show_sidebar %} main-collection__wrapper--hide-filters{% endunless %}">
                {%- if show_sidebar -%}
                  {% render 'facets',
                    results: search,
                    sidebar_position: sidebar_position,
                    enable_sorting: enable_sorting,
                    animation_effect: animation_effect,
                    show_faceted_filters: enable_filtering
                  %}
                  <noscript>
                    {% render 'facets-nojs',
                      results: search,
                      form_id: 'facets-3',
                      sidebar_position: sidebar_position,
                      enable_sorting: enable_sorting,
                      animation_effect: animation_effect
                    %}
                  </noscript>
                {%- endif -%}

                <div class="main-collection__list" data-product-container>
                  <product-grid-container data-section-id="{{ section.id }}">
                    {% render 'product-grid-header',
                      results: search,
                      sidebar_position: sidebar_position,
                      enable_filtering: show_sidebar,
                      products_per_page: limit,
                      enable_sorting: enable_sorting,
                      enable_product_count: enable_product_count
                    %}

                    {%- if search.results.size == 0 -%}
                      <div class="product-grid product-grid--empty" data-id="{{ section.id }}">
                        <div class="text-center">
                          <h2 class="h4">{{ 'sections.collection_template.empty' | t }}</h2>
                          <p>{{ 'sections.collection_template.use_fewer_filters_html' | t: link: search.url, class: 'underlined-link' }}</p>
                        </div>
                      </div>
                    {%- else -%}
                      <grid-list
                        id="product-grid"
                        data-id="{{ section.id }}"
                        class="ori ori-grid ori-cgrid__grid f-grid-2-cols"
                        data-products-grid
                      >
                        {%- for product in products_list -%}
                          <div class="f-column">
                            {%- render 'ori-product-card', product: product, button: 'cart' -%}
                          </div>
                        {%- endfor -%}
                        {%- for article in articles_list -%}
                          <div class="f-column">
                            <a class="ori-search__card" href="{{ article.url }}">
                              {%- if article.image -%}
                                {{ article.image | image_url: width: 600 | image_tag: widths: '300, 600', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', class: 'ori-search__card-img', alt: article.title }}
                              {%- endif -%}
                              <span class="ori-search__card-tag">Article</span>
                              <span class="ori-search__card-title">{{ article.title | escape }}</span>
                            </a>
                          </div>
                        {%- endfor -%}
                        {%- for page in pages_list -%}
                          <div class="f-column">
                            <a class="ori-search__card" href="{{ page.url }}">
                              <span class="ori-search__card-tag">{{ 'templates.search.page' | t }}</span>
                              <span class="ori-search__card-title">{{ page.title | escape }}</span>
                            </a>
                          </div>
                        {%- endfor -%}
                      </grid-list>
                    {%- endif -%}

                    {%- if paginate.pages > 1 -%}
                      <div class="main-collection__pagination f-pagination__wrapper text-center">
                        {%- render 'pagination', paginate: paginate -%}
                      </div>
                    {%- endif -%}
                  </product-grid-container>
                </div>
              </div>
            </div>
          {%- endpaginate -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>
{% schema %}
{
  "name": "t:sections.main-search.name",
  "class": "f-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.general.name"
    },
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.common.container.fixed"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.common.container.stretched"
        },
        {
          "value": "container-full",
          "label": "t:sections.common.container.fullwidth"
        }
      ],
      "default": "container",
      "label": "t:sections.common.container.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.grid.name"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.main-search.settings.limit.label",
      "min": 8,
      "max": 36,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.common.grid.columns",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "column_gap",
      "label": "t:sections.common.grid.gap",
      "options": [
        {
          "label": "t:sections.common.grid.gap_options.option_04",
          "value": "none"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_07",
          "value": "double-extra-small"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_05",
          "value": "extra-small"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_03",
          "value": "small"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_02",
          "value": "medium"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_01",
          "value": "large"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_06",
          "value": "extra-large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "row_gap",
      "label": "t:sections.common.grid.row_gap",
      "options": [
        {
          "label": "t:sections.common.grid.gap_options.option_04",
          "value": "none"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_07",
          "value": "double-extra-small"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_05",
          "value": "extra-small"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_03",
          "value": "small"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_02",
          "value": "medium"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_01",
          "value": "large"
        },
        {
          "label": "t:sections.common.grid.gap_options.option_06",
          "value": "extra-large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "enable_product_count",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_product_count.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "select",
      "id": "sidebar_position",
      "label": "t:sections.main-collection-product-grid.settings.position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.main-collection-product-grid.settings.position.option__1"
        },
        {
          "value": "right",
          "label": "t:sections.main-collection-product-grid.settings.position.option__2"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection-product-grid.settings.position.option__3"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "group_collapsible",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.collapsible.label"
    },
    {
      "type": "checkbox",
      "id": "open_first_group",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.open_first_group.label"
    },
    {
      "type": "checkbox",
      "id": "show_results_count",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.show_results_count.label"
    },
    {
      "type": "select",
      "id": "filter_color_type",
      "label": "t:sections.main-collection-product-grid.settings.filter_color_type.label",
      "options": [
        {
          "value": "inline",
          "label": "t:sections.main-collection-product-grid.settings.filter_color_type.option_1"
        },
        {
          "value": "list",
          "label": "t:sections.main-collection-product-grid.settings.filter_color_type.option_2"
        }
      ],
      "default": "inline"
    },
    {
      "type": "header",
      "content": "t:sections.common.section_padding.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.section_padding.top_padding.label",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.section_padding.bottom_padding.label",
      "default": 40,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ]
}
{% endschema %}
