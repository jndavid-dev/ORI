{%- comment -%}
  GVM Download Banner -- the wide dark band with a heading and a single
  download call to action on the left, and supporting copy on the right.
  Used at the top of the Instructions tab on a vehicle hub.

  File resolution matches sections/gvm-downloads.liquid: a filename from
  Settings > Files (served through file_url, with a real download
  attribute) or an external Dropbox / Drive link. Shopify wins when both
  are filled in, so the hosting decision stays a per-item choice rather
  than something baked into the build.

  Renders with the button disabled rather than hidden when no file is
  attached yet, so the layout can be reviewed before content lands.
{%- endcomment -%}

{%- liquid
  assign custom_class = section.settings.custom_class
  unless custom_class == blank
    assign custom_class = custom_class | prepend: ' '
  endunless

  assign file_href = section.settings.external_url
  assign is_shopify_file = false
  if section.settings.shopify_file != blank
    assign file_href = section.settings.shopify_file | file_url
    assign is_shopify_file = true
  endif
-%}

{{ 'gvm-css-main.css' | asset_url | stylesheet_tag }}

<div
  class="gvm-download-banner{{ custom_class }}"
  style="
    --gvm-banner-bg: {{ section.settings.background_color }};
    --gvm-banner-text: {{ section.settings.text_color }};
    --gvm-banner-btn-bg: {{ section.settings.button_color }};
    --gvm-banner-btn-text: {{ section.settings.button_text_color }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="container">
    <div class="gvm-download-banner__inner">
      <div class="gvm-download-banner__main">
        {%- if section.settings.heading != blank -%}
          <h2 class="gvm-download-banner__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if file_href != blank -%}
          <a
            class="gvm-download-banner__btn"
            href="{{ file_href }}"
            {% if is_shopify_file %}download{% else %}target="_blank" rel="noopener"{% endif %}
          >
            {{ section.settings.button_label }}
          </a>
        {%- else -%}
          <span class="gvm-download-banner__btn gvm-download-banner__btn--empty" aria-disabled="true">
            {{ section.settings.button_label }}
          </span>
        {%- endif -%}
      </div>

      {%- if section.settings.text != blank -%}
        <div class="gvm-download-banner__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "GVM Download Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Installation Instructions"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Download PDF"
    },
    {
      "type": "text",
      "id": "shopify_file",
      "label": "Shopify file name",
      "info": "Exact filename as uploaded in Settings > Files, e.g. silverado-1500-instructions.pdf. Takes priority over the external URL."
    },
    {
      "type": "url",
      "id": "external_url",
      "label": "External URL",
      "info": "Dropbox, Google Drive or any other link. Used when no Shopify file name is set."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#56bdc2"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class",
      "info": "Use gvm-tab-panel gvm-tab-panel--N to place this inside a tab."
    }
  ],
  "presets": [
    { "name": "GVM Download Banner" }
  ]
}
{% endschema %}
