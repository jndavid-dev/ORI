{%- comment -%}
  ORI redesign — Vehicle grid (blocks). The "Browse by vehicle" card design
  from the GVM hub (snippets/ori-vehicle-card.liquid, .ori-vcard styles),
  but with a block per vehicle so each page can list its own set, plus a
  specs line and an optional brochure (PDF) link under the main button.
  The card itself is snippets/ori-vgrid-card.liquid, shared with the
  ORI GVM packages section.

  A card with no link renders "Coming soon" instead of a dead button. Each
  block's image falls back to a theme asset (e.g. the vehicle crops shipped
  with the theme) when no image is picked.
{%- endcomment -%}
{%- assign vehicles = section.blocks | where: 'type', 'vehicle' -%}
<div
  {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}
  class="ori ori-section ori-vgrid-section"
  style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="ori-wrap">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="ori-head">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="ori-h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <p class="ori-head__intro">{{ section.settings.intro }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- liquid
      case section.settings.image_ratio
        when 'portrait'
          assign vratio = '0.71 / 1'
        when 'landscape'
          assign vratio = '16 / 9'
        else
          assign vratio = '1 / 1'
      endcase
    -%}
    <ul class="ori-vgrid ori-vgrid--wide" style="--ori-cols: {{ section.settings.columns }}; --ori-vratio: {{ vratio }};" role="list">
      {%- for block in vehicles -%}
        {%- liquid
          assign asset_img = block.settings.image_asset | strip
          if asset_img != blank
            assign asset_img = asset_img | asset_url
          endif
        -%}
        {%- render 'ori-vgrid-card',
          title: block.settings.title,
          specs: block.settings.specs,
          text: block.settings.text,
          url: block.settings.url,
          image: block.settings.image,
          image_src: asset_img,
          button_label: block.settings.button_label,
          pdf_url: block.settings.pdf_url,
          pdf_label: block.settings.pdf_label,
          attrs: block.shopify_attributes
        -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "ORI Vehicle grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Browse by vehicle" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square (vehicle tiles)" },
        { "value": "portrait", "label": "Portrait (GVM hub)" },
        { "value": "landscape", "label": "Landscape 16:9" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Cards per row (desktop)",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Lets buttons link here, e.g. vehicles → #vehicles." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "vehicle",
      "name": "Vehicle",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Match the Image shape setting; square tiles by default." },
        { "type": "text", "id": "image_asset", "label": "Fallback image (theme asset file name)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Ford F150" },
        { "type": "text", "id": "specs", "label": "Specs line", "placeholder": "4300 GVM | 8800 GCM | 35\" tyres legal" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "url", "id": "url", "label": "Link", "info": "Empty shows \"Coming soon\"." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "View packages & pricing" },
        { "type": "url", "id": "pdf_url", "label": "Brochure (PDF) link" },
        { "type": "text", "id": "pdf_label", "label": "Brochure link label", "default": "Download brochure (PDF)" }
      ]
    }
  ],
  "presets": [{ "name": "ORI Vehicle grid" }]
}
{% endschema %}
