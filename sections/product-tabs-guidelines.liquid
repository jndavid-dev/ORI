{% comment %}
  Product Tabs (Guidelines)
  - Tabs are blocks so you can add/remove/reorder easily
  - Tabs auto-hide if their content is empty (metafield/page/custom/liquid)
  - Reviews: a scroll-to anchor. It only shows when "Reviews scroll selector"
    is set AND that element exists on the page (checked in the script below),
    so there is never an empty Reviews tab when no reviews app is installed.
  - If only one tab has content, it renders as a plain headed block with no
    tab bar ("Overview" on its own is not a tab).
  - Style "ORI" (setting) uses the redesign look from assets/gvm-css-main.css
    (ORI REDESIGN — PRODUCT TABS). "Classic" is the original bordered box.
{% endcomment %}

{%- liquid
  assign is_ori = false
  if section.settings.style == 'ori'
    assign is_ori = true
  endif

  # One pass decides which tabs have content. visible_ids is a |id| list so a
  # contains check can't match one id inside another.
  assign visible_ids = '|'
  assign visible_count = 0
  assign content_count = 0
  assign first_visible_block_id = ''

  for block in section.blocks
    assign show_tab = false

    case block.settings.content_type
      when 'product_description'
        assign desc_text = product.description | strip_html | strip
        if desc_text != blank
          assign show_tab = true
        endif

      when 'metafield'
        assign ns = block.settings.metafield_namespace | strip
        assign key = block.settings.metafield_key | strip
        assign mf_text = ''
        if ns != blank and key != blank
          assign mf = product.metafields[ns][key]
          if mf != blank
            assign mf_text = mf | metafield_tag | strip_html | strip
          endif
        endif
        if mf_text != blank
          assign show_tab = true
        endif

      when 'page'
        if block.settings.page != blank
          assign page_text = pages[block.settings.page].content | strip_html | strip
          if page_text != blank
            assign show_tab = true
          endif
        endif

      when 'custom'
        assign custom_text = block.settings.custom_richtext | strip_html | strip
        if custom_text != blank
          assign show_tab = true
        endif

      when 'custom_liquid'
        assign liq_raw = block.settings.custom_liquid | strip
        if liq_raw != blank
          assign show_tab = true
        endif

      when 'reviews_anchor'
        assign selector = block.settings.scroll_selector | strip
        if selector != blank
          assign show_tab = true
        endif
    endcase

    if request.design_mode
      assign show_tab = true
    endif

    if show_tab
      assign visible_ids = visible_ids | append: block.id | append: '|'
      assign visible_count = visible_count | plus: 1
      if block.settings.content_type != 'reviews_anchor'
        assign content_count = content_count | plus: 1
      endif
      if first_visible_block_id == '' and block.settings.content_type != 'reviews_anchor'
        assign first_visible_block_id = block.id
      endif
    endif
  endfor

  # A single content tab (with or without a reviews anchor) drops the tab bar.
  assign single = false
  if content_count == 1 and request.design_mode == false
    assign single = true
  endif

  assign section_class = 'pc-tabs'
  if is_ori
    assign section_class = 'pc-tabs ori ori-ptabs'
    if single
      assign section_class = section_class | append: ' ori-ptabs--single'
    endif
  endif
-%}

{%- if content_count > 0 or request.design_mode -%}
<section
  id="Tabs-{{ section.id }}"
  class="{{ section_class }}"
  {% if is_ori %}style="--ori-pt: {{ section.settings.padding_top }}px; --ori-pb: {{ section.settings.padding_bottom }}px;"{% endif %}
>
  <div class="pc-tabs__wrap{% if is_ori %} ori-wrap{% endif %}">
    {%- if single -%}
      {%- for block in section.blocks -%}
        {%- if block.id == first_visible_block_id -%}
          <h2 class="pc-tabs__heading{% if is_ori %} ori-h2{% endif %}" {{ block.shopify_attributes }}>
            {{- block.settings.title | escape -}}
          </h2>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <div class="pc-tabs__nav" role="tablist" aria-label="Product information">
        {%- for block in section.blocks -%}
          {%- assign needle = '|' | append: block.id | append: '|' -%}
          {%- if visible_ids contains needle -%}
            {%- assign tab_id = 'tab-' | append: section.id | append: '-' | append: block.id -%}
            {%- assign panel_id = 'panel-' | append: section.id | append: '-' | append: block.id -%}
            {%- assign is_first = false -%}
            {%- if block.id == first_visible_block_id -%}{%- assign is_first = true -%}{%- endif -%}
            <button
              id="{{ tab_id }}"
              class="pc-tabs__tab{% if is_first %} is-active{% endif %}"
              type="button"
              role="tab"
              aria-selected="{% if is_first %}true{% else %}false{% endif %}"
              aria-controls="{{ panel_id }}"
              data-panel="{{ panel_id }}"
              tabindex="{% if is_first %}0{% else %}-1{% endif %}"
              {% if block.settings.content_type == 'reviews_anchor' %}
                data-reviews-tab
                data-scroll-selector="{{ block.settings.scroll_selector | strip | escape }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {{ block.settings.title | escape }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="pc-tabs__panels">
      {%- for block in section.blocks -%}
        {%- assign needle = '|' | append: block.id | append: '|' -%}
        {%- unless visible_ids contains needle -%}{%- continue -%}{%- endunless -%}
        {%- if single and block.id != first_visible_block_id -%}{%- continue -%}{%- endif -%}

        {%- assign panel_id = 'panel-' | append: section.id | append: '-' | append: block.id -%}
        {%- assign tab_id = 'tab-' | append: section.id | append: '-' | append: block.id -%}
        {%- assign is_first = false -%}
        {%- if block.id == first_visible_block_id -%}{%- assign is_first = true -%}{%- endif -%}

        <div
          id="{{ panel_id }}"
          class="pc-tabs__panel rte{% if is_first %} is-active{% endif %}"
          {% unless single %}
            role="tabpanel"
            aria-labelledby="{{ tab_id }}"
            {% unless is_first %}hidden{% endunless %}
          {% endunless %}
        >
          {% case block.settings.content_type %}
            {% when 'product_description' %}
              {{ product.description }}

            {% when 'metafield' %}
              {% assign ns = block.settings.metafield_namespace | strip %}
              {% assign key = block.settings.metafield_key | strip %}
              {% assign mf = blank %}
              {% if ns != blank and key != blank %}
                {% assign mf = product.metafields[ns][key] %}
              {% endif %}

              {% if mf != blank %}
                {{ mf | metafield_tag }}
              {% elsif request.design_mode %}
                <p><strong>Metafield is empty.</strong> This tab will hide on live if left empty.</p>
              {% endif %}

            {% when 'page' %}
              {% if block.settings.page != blank %}
                {{ pages[block.settings.page].content }}
              {% endif %}

            {% when 'custom' %}
              {{ block.settings.custom_richtext }}

            {% when 'custom_liquid' %}
              {{ block.settings.custom_liquid }}

            {% when 'reviews_anchor' %}
              {% if request.design_mode %}
                <p>This tab scrolls to your reviews section and hides when that section isn't on the page.</p>
                <p>Set <code>Reviews scroll selector</code> (example: <code>#judgeme_product_reviews</code>).</p>
              {% endif %}
          {% endcase %}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- unless is_ori -%}
  <style>
    #Tabs-{{ section.id }} .pc-tabs__wrap{
      border: 2px solid #000;
      padding: 26px 28px;
      background: #fff;
    }
    #Tabs-{{ section.id }} .pc-tabs__heading{
      margin: 0 0 10px;
      font-size: 16px;
      font-weight: 500;
      letter-spacing: .06em;
      text-transform: uppercase;
    }
    #Tabs-{{ section.id }} .pc-tabs__nav{
      display: flex;
      gap: 34px;
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 10px;
    }
    #Tabs-{{ section.id }} .pc-tabs__nav::-webkit-scrollbar{ display:none; }
    #Tabs-{{ section.id }} .pc-tabs__tab{
      appearance: none;
      background: transparent;
      border: 0;
      padding: 0 0 10px;
      cursor: pointer;
      font-family: var(--brand-body-font, sans-serif);
      font-weight: 500;
      font-size: 16px;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: #000;
      position: relative;
      white-space: nowrap;
    }
    #Tabs-{{ section.id }} .pc-tabs__tab.is-active::after{
      content:"";
      position:absolute;
      left:0;
      bottom:0;
      height: 3px;
      width: 100%;
      background: #000;
    }
    #Tabs-{{ section.id }} .pc-tabs__panels{ padding-top: 18px; }
    #Tabs-{{ section.id }} .pc-tabs__panel{
      font-family: var(--brand-body-font, sans-serif);
      font-weight: 400;
      color: #000;
    }
    #Tabs-{{ section.id }} .pc-tabs__panel p{ margin: 0 0 12px; }
    #Tabs-{{ section.id }} .pc-tabs__panel ul{ margin: 0 0 12px 20px; }

    @media (max-width: 768px){
      #Tabs-{{ section.id }} .pc-tabs__wrap{ padding: 18px 16px; }
      #Tabs-{{ section.id }} .pc-tabs__tab{ font-size: 14px; }
      #Tabs-{{ section.id }} .pc-tabs__nav{ gap: 22px; }
    }
  </style>
  {%- endunless -%}

  {%- unless single -%}
  <script>
    (function() {
      var root = document.getElementById("Tabs-{{ section.id }}");
      if (!root) return;

      // Reviews anchor: hide the tab when its target isn't on the page.
      // Runs again after load, because review apps usually inject late.
      function pruneReviews() {
        if (window.Shopify && Shopify.designMode) return;
        root.querySelectorAll('[data-reviews-tab]').forEach(function(tab) {
          var target = null;
          try { target = document.querySelector(tab.dataset.scrollSelector); } catch (e) {}
          tab.hidden = !target;
        });
      }

      function tabs() {
        return root.querySelectorAll('[role="tab"]:not([hidden])');
      }

      function activateTab(tabEl, scroll) {
        if (tabEl.dataset.scrollSelector) {
          var target = null;
          try { target = document.querySelector(tabEl.dataset.scrollSelector); } catch (e) {}
          if (target && scroll) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }

        var panelId = tabEl.getAttribute('data-panel');
        root.querySelectorAll('[role="tab"]').forEach(function(t){
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
          t.setAttribute('tabindex', '-1');
        });
        root.querySelectorAll('[role="tabpanel"]').forEach(function(p){
          p.classList.remove('is-active');
          p.hidden = true;
        });

        tabEl.classList.add('is-active');
        tabEl.setAttribute('aria-selected', 'true');
        tabEl.setAttribute('tabindex', '0');

        var panel = root.querySelector('#' + panelId);
        if (panel) {
          panel.classList.add('is-active');
          panel.hidden = false;
        }
      }

      root.querySelectorAll('[role="tab"]').forEach(function(tab){
        tab.addEventListener('click', function(){
          activateTab(tab, true);
        });

        tab.addEventListener('keydown', function(e){
          var list = Array.prototype.slice.call(tabs());
          var idx = list.indexOf(tab);
          var next = null;
          if (e.key === 'ArrowRight') next = list[idx + 1] || list[0];
          if (e.key === 'ArrowLeft') next = list[idx - 1] || list[list.length - 1];
          if (next) {
            e.preventDefault();
            next.focus();
            activateTab(next, false);
          }
        });
      });

      pruneReviews();
      window.addEventListener('load', pruneReviews);
    })();
  </script>
  {%- endunless -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product tabs (Guidelines)",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "classic",
      "options": [
        { "value": "classic", "label": "Classic (bordered box)" },
        { "value": "ori", "label": "ORI redesign" }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (ORI style)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (ORI style)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "title", "label": "Tab title", "default": "Overview" },
        {
          "type": "select",
          "id": "content_type",
          "label": "Content source",
          "default": "product_description",
          "options": [
            { "value": "product_description", "label": "Product description" },
            { "value": "metafield", "label": "Metafield (per product)" },
            { "value": "page", "label": "Page content" },
            { "value": "custom", "label": "Custom rich text" },
            { "value": "custom_liquid", "label": "Custom liquid (embed app snippet)" },
            { "value": "reviews_anchor", "label": "Reviews (scroll to reviews section)" }
          ]
        },
        { "type": "text", "id": "metafield_namespace", "label": "Metafield namespace (e.g. custom)", "default": "custom" },
        { "type": "text", "id": "metafield_key", "label": "Metafield key (e.g. product_installation)" },
        { "type": "page", "id": "page", "label": "Select page" },
        { "type": "richtext", "id": "custom_richtext", "label": "Custom content" },
        { "type": "liquid", "id": "custom_liquid", "label": "Custom liquid (optional)" },
        {
          "type": "text",
          "id": "scroll_selector",
          "label": "Reviews scroll selector (e.g. #judgeme_product_reviews)",
          "info": "The Reviews tab only shows when this is set and the element is on the page."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Product tabs (Guidelines)",
      "blocks": [
        { "type": "tab", "settings": { "title": "Overview", "content_type": "product_description" } },
        { "type": "tab", "settings": { "title": "Important Notes", "content_type": "metafield", "metafield_namespace": "custom", "metafield_key": "product_important_notes" } },
        { "type": "tab", "settings": { "title": "Installation", "content_type": "metafield", "metafield_namespace": "custom", "metafield_key": "product_installation" } },
        { "type": "tab", "settings": { "title": "Specification", "content_type": "metafield", "metafield_namespace": "custom", "metafield_key": "product_specification" } },
        { "type": "tab", "settings": { "title": "Fitment", "content_type": "metafield", "metafield_namespace": "custom", "metafield_key": "product_fitment" } },
        { "type": "tab", "settings": { "title": "Reviews", "content_type": "reviews_anchor", "scroll_selector": "#judgeme_product_reviews" } }
      ]
    }
  ]
}
{% endschema %}
