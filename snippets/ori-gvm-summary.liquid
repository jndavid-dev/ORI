{%- comment -%}
  ORI redesign — turns a GVM stage summary into page parts. The summaries
  are written as plain text in a fixed pattern, e.g.

    Chevrolet Silverado 1500 ZR2.
    - GVM: 3650kg | GCM: 7160kg | Braked Towing: 4200kg
    - Payload: 1077kg, a 42.28% increase on the factory 757kg.
    - Lift & Tyres: 4" BDS lift, 37" tyres legal …
    NOTE: Aftermarket wheels are required for this stage.
    Wheels and tyres not included.

  and this reads that pattern:
  - lines before the first "- " item          → intro paragraphs
  - "- A: x | B: y | C: z" (several pairs)      → key figures
  - "- GVM Increase: 4250kg." (GVM/GCM/towing)   → key figure
  - "- Payload: 1077kg, a …"                     → key figure (1077kg) + small note
  - "- NOTE: …"                                  → highlighted note
  - "- Key: value"                               → specification rows
  - "NOTE: …" and plain lines after the items    → highlighted notes
  Anything that doesn't fit falls through as text, so an unusual summary
  still shows in full. The summary is the stage_summary metafield, or the
  product description flattened by snippets/ori-gvm-desc-lines.liquid.

  When the product has GVM/GCM metafields (original_gvm, upgraded_gvm …)
  the key figures use those instead, showing original → upgraded.

  Accepts:
  - summary: {String} plain text with line breaks
  - part: {String} 'intro' | 'figures' | 'details'
  - original_gvm, upgraded_gvm, original_gcm, upgraded_gcm, payload: {String} optional metafield figures
{%- endcomment -%}
{%- liquid
  assign intro = ''
  assign facts = ''
  assign notes = ''
  assign figures = ''
  assign seen_item = false

  assign lines = summary | newline_to_br | split: '<br />'
  for raw in lines
    assign l = raw | strip
    if l == blank
      continue
    endif
    assign head2 = l | slice: 0, 2
    assign head5 = l | slice: 0, 5 | upcase

    if head2 == '- ' or head2 == '• '
      assign seen_item = true
      assign item = l | slice: 2, 2000 | strip

      if item contains '|' and item contains ':'
        assign pairs = item | split: '|'
        for p in pairs
          assign k = p | split: ':' | first | strip
          assign v = p | remove_first: k | remove_first: ':' | strip
          assign figures = figures | append: '<div class="ori-fig"><dt>' | append: k | append: '</dt><dd>' | append: v | append: '</dd></div>'
        endfor
      elsif item contains ':'
        assign k = item | split: ':' | first | strip
        assign v = item | remove_first: k | remove_first: ':' | strip
        assign kd = k | downcase
        assign v_end = v | slice: -1
        assign v_clean = v
        if v_end == '.'
          assign v_clean = v | remove_last: '.'
        endif
        if kd == 'note'
          assign notes = notes | append: '<p class="ori-note"><strong>Note:</strong> ' | append: v | append: '</p>'
        elsif kd contains 'gvm' or kd contains 'gcm' or kd contains 'towing'
          assign figures = figures | append: '<div class="ori-fig"><dt>' | append: k | append: '</dt><dd>' | append: v_clean | append: '</dd></div>'
        elsif kd == 'payload'
          assign v_main = v | split: ',' | first | strip
          assign v_rest = v | remove_first: v_main | remove_first: ',' | strip
          assign v_rest_end = v_rest | slice: -1
          if v_rest_end == '.'
            assign v_rest = v_rest | remove_last: '.'
          endif
          assign figures = figures | append: '<div class="ori-fig"><dt>Payload</dt><dd>' | append: v_main
          if v_rest != blank
            assign figures = figures | append: '<small>' | append: v_rest | append: '</small>'
          endif
          assign figures = figures | append: '</dd></div>'
        else
          assign facts = facts | append: '<div><dt>' | append: k | append: '</dt><dd>' | append: v | append: '</dd></div>'
        endif
      else
        assign notes = notes | append: '<p class="ori-note">' | append: item | append: '</p>'
      endif

    elsif head5 == 'NOTE:'
      assign note_text = l | slice: 5, 2000 | strip
      assign notes = notes | append: '<p class="ori-note"><strong>Note:</strong> ' | append: note_text | append: '</p>'

    elsif seen_item
      assign notes = notes | append: '<p class="ori-note">' | append: l | append: '</p>'

    else
      assign intro = intro | append: '<p>' | append: l | append: '</p>'
    endif
  endfor

  comment
    Metafield figures, when present, are the source of truth.
  endcomment
  if original_gvm != blank or upgraded_gvm != blank or original_gcm != blank or upgraded_gcm != blank or payload != blank
    assign figures = ''
    if upgraded_gvm != blank or original_gvm != blank
      assign gvm_new = upgraded_gvm | default: original_gvm
      assign figures = figures | append: '<div class="ori-fig"><dt>GVM</dt><dd>'
      if original_gvm != blank and upgraded_gvm != blank and original_gvm != upgraded_gvm
        assign figures = figures | append: '<s>' | append: original_gvm | append: '</s> '
      endif
      assign figures = figures | append: gvm_new | append: '</dd></div>'
    endif
    if upgraded_gcm != blank or original_gcm != blank
      assign gcm_new = upgraded_gcm | default: original_gcm
      assign figures = figures | append: '<div class="ori-fig"><dt>GCM</dt><dd>'
      if original_gcm != blank and upgraded_gcm != blank and original_gcm != upgraded_gcm
        assign figures = figures | append: '<s>' | append: original_gcm | append: '</s> '
      endif
      assign figures = figures | append: gcm_new | append: '</dd></div>'
    endif
    if payload != blank
      assign figures = figures | append: '<div class="ori-fig"><dt>Payload gain</dt><dd>+' | append: payload | append: '</dd></div>'
    endif
  endif
-%}
{%- case part -%}
  {%- when 'intro' -%}
    {%- if intro != blank -%}
      {{ intro }}
    {%- elsif seen_item == false -%}
      {%- comment -%} Not in the usual pattern — show the summary as written. {%- endcomment -%}
      <p>{{ summary | newline_to_br }}</p>
    {%- endif -%}
  {%- when 'figures' -%}
    {%- if figures != blank -%}
      <dl class="ori-figs">{{ figures }}</dl>
    {%- endif -%}
  {%- when 'details' -%}
    {%- if facts != blank -%}
      <dl class="ori-spec">{{ facts }}</dl>
    {%- endif -%}
    {%- if notes != blank -%}
      <div class="ori-gvmp__notes">{{ notes }}</div>
    {%- endif -%}
{%- endcase -%}
