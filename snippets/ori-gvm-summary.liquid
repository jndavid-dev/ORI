{%- comment -%}
  ORI redesign — turns a GVM stage summary into page parts. The summaries
  are written as plain text in a fixed pattern, e.g.

    Chevrolet Silverado 1500 ZR2.
    - GVM: 3650kg | GCM: 7160kg | Braked Towing: 4200kg
    - Payload: 1077kg, a 42.28% increase on the factory 757kg.
    - Lift & Tyres: 4" BDS lift, 37" tyres legal …
    NOTE: Aftermarket wheels are required for this stage.
    Wheels and tyres not included.

  and this reads that pattern:
  - lines before the first "- " item          → intro paragraphs
  - "- A: x | B: y | C: z" (several pairs)      → compliance plate rows
  - "- Payload: 1077kg, a …"                     → plate row (1077kg) + small note
  - "- GVM Increase: 4250kg." (GVM/GCM/towing)   → plate row
  - "- NOTE: …"                                  → highlighted note
  - "- Key: value"                               → package detail rows
  - "NOTE: …" and plain lines after the items    → highlighted notes
  Anything that doesn't fit falls through as text, so an unusual summary
  still shows in full.

  When the product has GVM/GCM metafields (original_gvm, upgraded_gvm …)
  the plate uses those instead, showing original → upgraded.

  Accepts:
  - summary: {String} plain text with line breaks
  - part: {String} 'intro' | 'plate' | 'details'
  - original_gvm, upgraded_gvm, original_gcm, upgraded_gcm, payload: {String} optional metafield figures
  - sku: {String} optional, printed on the plate like a part number
{%- endcomment -%}
{%- liquid
  assign intro = ''
  assign facts = ''
  assign notes = ''
  assign plate_rows = ''
  assign seen_item = false

  assign lines = summary | newline_to_br | split: '<br />'
  for raw in lines
    assign l = raw | strip
    if l == blank
      continue
    endif
    assign head2 = l | slice: 0, 2
    assign head5 = l | slice: 0, 5 | upcase

    if head2 == '- ' or head2 == '• '
      assign seen_item = true
      assign item = l | slice: 2, 2000 | strip

      if item contains '|' and item contains ':'
        assign pairs = item | split: '|'
        for p in pairs
          assign k = p | split: ':' | first | strip
          assign v = p | remove_first: k | remove_first: ':' | strip
          capture row
            echo '<div class="ori-plate__row"><span class="ori-plate__k">' | append: k | append: '</span><span class="ori-plate__v"><span class="ori-plate__new">' | append: v | append: '</span></span></div>'
          endcapture
          assign plate_rows = plate_rows | append: row
        endfor
      elsif item contains ':'
        assign k = item | split: ':' | first | strip
        assign v = item | remove_first: k | remove_first: ':' | strip
        assign kd = k | downcase
        assign v_end = v | slice: -1
        assign v_clean = v
        if v_end == '.'
          assign v_clean = v | remove_last: '.'
        endif
        if kd == 'note'
          assign notes = notes | append: '<p class="ori-note"><strong>Note:</strong> ' | append: v | append: '</p>'
        elsif kd contains 'gvm' or kd contains 'gcm' or kd contains 'towing'
          capture row
            echo '<div class="ori-plate__row"><span class="ori-plate__k">' | append: k | append: '</span><span class="ori-plate__v"><span class="ori-plate__new">' | append: v_clean | append: '</span></span></div>'
          endcapture
          assign plate_rows = plate_rows | append: row
        elsif kd == 'payload'
          assign v_main = v | split: ',' | first | strip
          assign v_rest = v | remove_first: v_main | remove_first: ',' | strip
          assign v_rest_end = v_rest | slice: -1
          if v_rest_end == '.'
            assign v_rest = v_rest | remove_last: '.'
          endif
          capture row
            echo '<div class="ori-plate__row ori-plate__row--sm"><span class="ori-plate__k">Payload</span><span class="ori-plate__v"><span class="ori-plate__new">' | append: v_main | append: '</span>'
            if v_rest != blank
              echo '<span class="ori-plate__sub">' | append: v_rest | append: '</span>'
            endif
            echo '</span></div>'
          endcapture
          assign plate_rows = plate_rows | append: row
        else
          capture row
            echo '<div><dt>' | append: k | append: '</dt><dd>' | append: v | append: '</dd></div>'
          endcapture
          assign facts = facts | append: row
        endif
      else
        assign notes = notes | append: '<p class="ori-note">' | append: item | append: '</p>'
      endif

    elsif head5 == 'NOTE:'
      assign note_text = l | slice: 5, 2000 | strip
      assign notes = notes | append: '<p class="ori-note"><strong>Note:</strong> ' | append: note_text | append: '</p>'

    elsif seen_item
      assign notes = notes | append: '<p class="ori-note">' | append: l | append: '</p>'

    else
      assign intro = intro | append: '<p>' | append: l | append: '</p>'
    endif
  endfor

  comment
    Metafield figures, when present, are the source of truth for the plate.
  endcomment
  if original_gvm != blank or upgraded_gvm != blank or original_gcm != blank or upgraded_gcm != blank or payload != blank
    assign plate_rows = ''
    if upgraded_gvm != blank or original_gvm != blank
      assign plate_rows = plate_rows | append: '<div class="ori-plate__row"><span class="ori-plate__k">GVM</span><span class="ori-plate__v">'
      if original_gvm != blank and upgraded_gvm != blank and original_gvm != upgraded_gvm
        assign plate_rows = plate_rows | append: '<span class="ori-plate__old">' | append: original_gvm | append: '</span>'
      endif
      assign gvm_new = upgraded_gvm | default: original_gvm
      assign plate_rows = plate_rows | append: '<span class="ori-plate__new">' | append: gvm_new | append: '</span></span></div>'
    endif
    if upgraded_gcm != blank or original_gcm != blank
      assign plate_rows = plate_rows | append: '<div class="ori-plate__row ori-plate__row--sm"><span class="ori-plate__k">GCM</span><span class="ori-plate__v">'
      if original_gcm != blank and upgraded_gcm != blank and original_gcm != upgraded_gcm
        assign plate_rows = plate_rows | append: '<span class="ori-plate__old">' | append: original_gcm | append: '</span>'
      endif
      assign gcm_new = upgraded_gcm | default: original_gcm
      assign plate_rows = plate_rows | append: '<span class="ori-plate__new">' | append: gcm_new | append: '</span></span></div>'
    endif
    if payload != blank
      assign plate_rows = plate_rows | append: '<div class="ori-plate__row ori-plate__row--sm"><span class="ori-plate__k">Payload</span><span class="ori-plate__v"><span class="ori-plate__new">+' | append: payload | append: '</span></span></div>'
    endif
  endif
-%}
{%- case part -%}
  {%- when 'intro' -%}
    {%- if intro != blank -%}
      {{ intro }}
    {%- elsif seen_item == false -%}
      {%- comment -%} Not in the usual pattern — show the summary as written. {%- endcomment -%}
      <p>{{ summary | newline_to_br }}</p>
    {%- endif -%}
  {%- when 'plate' -%}
    {%- if plate_rows != blank -%}
      <div class="ori-plate">
        <i class="ori-plate__rivet ori-plate__rivet--a"></i><i class="ori-plate__rivet ori-plate__rivet--b"></i><i class="ori-plate__rivet ori-plate__rivet--c"></i><i class="ori-plate__rivet ori-plate__rivet--d"></i>
        <div class="ori-plate__head"><b>Offroad Industries</b><span>Second-stage manufacturer</span></div>
        {{ plate_rows }}
        {%- if sku != blank -%}
          <div class="ori-plate__foot"><span>Part no.</span><span class="ori-plate__stamp">{{ sku }}</span></div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- when 'details' -%}
    {%- if facts != blank -%}
      <dl class="ori-spec">{{ facts }}</dl>
    {%- endif -%}
    {%- if notes != blank -%}
      <div class="ori-gvmp__notes">{{ notes }}</div>
    {%- endif -%}
{%- endcase -%}
