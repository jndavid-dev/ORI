{%- comment -%}
  ORI redesign line icons (hero features, download cards, buttons).
  Accepts:
  - icon: {String} shield | suspension | clipboard | tyre | download | document | banner | social | image | box
                    | truck | form | check | tag | card | search | arrow
                    | headset | network | award | warehouse | tow | play
{%- endcomment -%}
{%- case icon -%}
  {%- when 'shield' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 4 6 9v10c0 9 6 15 14 17 8-2 14-8 14-17V9z"/><path d="m13 20 5 5 9-10"/></svg>
  {%- when 'suspension' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M20 3v6M20 31v6M14 9h12v22H14zM14 14l12 3M14 20l12 3M14 26l12 3"/></svg>
  {%- when 'clipboard' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="8" y="6" width="24" height="30" rx="2"/><path d="M15 4h10v5H15zM13 17l2 2 4-4M22 17h6M13 26l2 2 4-4M22 26h6"/></svg>
  {%- when 'tyre' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" focusable="false"><circle cx="20" cy="20" r="16"/><circle cx="20" cy="20" r="7"/><path d="M20 4v9M20 27v9M4 20h9M27 20h9M9 9l6 6M25 25l6 6M31 9l-6 6M15 25l-6 6"/></svg>
  {%- when 'download' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3v12M7 10l5 5 5-5M4 19h16"/></svg>
  {%- when 'document' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 4h17l9 9v31H12z"/><path d="M29 4v9h9M18 24h14M18 31h14M18 38h9"/></svg>
  {%- when 'banner' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="10" width="40" height="22" rx="2"/><path d="M12 32v12M36 32v12M10 18h20M10 24h12"/></svg>
  {%- when 'social' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="6" y="6" width="36" height="36" rx="8"/><circle cx="24" cy="24" r="8"/><circle cx="34.5" cy="13.5" r="1.5" fill="currentColor"/></svg>
  {%- when 'image' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="8" width="40" height="32" rx="2"/><circle cx="16" cy="18" r="4"/><path d="m4 34 12-10 8 7 7-5 13 9"/></svg>
  {%- when 'box' -%}
    <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M24 4 6 13v22l18 9 18-9V13z"/><path d="m6 13 18 9 18-9M24 22v22"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
  {%- when 'form' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
  {%- when 'tag' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
  {%- when 'card' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  {%- when 'arrow' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'headset' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M8 24v-4a12 12 0 0 1 24 0v4"/><rect x="5" y="23" width="7" height="10" rx="2"/><rect x="28" y="23" width="7" height="10" rx="2"/><path d="M32 33c0 3-3 4-7 4h-3"/></svg>
  {%- when 'network' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 36s11-9.5 11-18a11 11 0 0 0-22 0c0 8.5 11 18 11 18z"/><circle cx="20" cy="18" r="4"/><path d="M4 30l5-2M36 30l-5-2"/></svg>
  {%- when 'award' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="20" cy="15" r="10"/><path d="m16 15 3 3 5-6"/><path d="m13 23-4 13 6-3 4 5 1-9M27 23l4 13-6-3-4 5"/></svg>
  {%- when 'warehouse' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 16 20 6l16 10v20H4z"/><path d="M10 36V22h20v14M10 28h20M16 22v6M24 28v8"/></svg>
  {%- when 'tow' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 26V16h12l4 6h4v4z"/><circle cx="9" cy="28" r="3"/><circle cx="19" cy="28" r="3"/><path d="M23 24h4M27 18h10v10H27z"/><circle cx="32" cy="30" r="2.5"/></svg>
  {%- when 'play' -%}
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="20" cy="20" r="17"/><path d="M16 13v14l11-7z" fill="currentColor"/></svg>
{%- endcase -%}
