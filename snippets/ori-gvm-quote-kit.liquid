{%- comment -%}
  One kit for the quote form's JSON (sections/ori-gvm-quote.liquid), as
  "<product id>": { title, url, image, variants: [...] }. Variant images
  fall back to the product's featured image; with no image at all the value
  is null rather than whatever the image_url filter returns for nothing, so
  the JSON always parses.

  Accepts:
  - p: {Object} product
{%- endcomment -%}
"{{ p.id }}": {
  "title": {{ p.title | json }},
  "url": {{ p.url | json }},
  "image": {% if p.featured_image %}{{ p.featured_image | image_url: width: 240 | json }}{% else %}null{% endif %},
  "variants": [
    {%- for v in p.variants -%}
      {%- assign v_image = v.image | default: p.featured_image -%}
      {
        "id": {{ v.id }},
        "title": {{ v.title | json }},
        "sku": {{ v.sku | json }},
        "image": {% if v_image %}{{ v_image | image_url: width: 240 | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
