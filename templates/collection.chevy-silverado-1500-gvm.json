        "subheading_JVKNjL": {
          "type": "subheading",
          "settings": {
            "subheading": "Stage 1: $11,500* - Installed & Engineered",
            "subheading_size": "h5"
          }
        },
        "heading_f9G7kD": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Stage 1: The Weekender Family Getaway (3650 KG GVM + GCM 8150 KG)</strong>",
            "highlight_style": "none",
            "enable_highlight_text_color": false,
            "heading_size": "h2"
          }
        },
        "text_fRRw7g": {
          "type": "text",
          "settings": {
            "text": "<p><em>The perfect entry point for those needing a legal payload boost without a major lift.</em></p><ul><li><strong>GVM Increase:</strong> Up to 3650 KG (approx. 1077 KG payload).</li><li><strong>Key Features:</strong> Fox 2.5 Performance Series shocks and ORI 200 KG heavy-duty leaf packs matched with heavy duty BDS control arms.</li><li><strong>Best For:</strong> Daily drivers and light towing where you need to clear the \"one-tonne\" mark for tax purposes (ATO compliance) or carry extra tools/gear legally.</li><li><strong>Benefit:</strong> Maintains a lifted stance with premium USA-made shocks,  while significantly improving stability under load without the need of purchasing load rated wheels.</li><li><strong>Part Number:</strong> CHV-1500-Stage1-GVM</li></ul>"
          }
        }
      },
      "block_order": [
        "subheading_JVKNjL",
