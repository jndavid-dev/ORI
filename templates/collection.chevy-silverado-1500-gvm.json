            "enable_highlight_text_color": false,
            "heading_size": "h2"
          }
        },
        "text_giGN6b": {
          "type": "text",
          "settings": {
            "text": "<p><em>Maximum legal capacity for the most demanding builds. Ideal for Tray Canopy builds and for the customer who wants to run 35\" Tyres legally.</em></p><ul><li><strong>GVM Increase:</strong> 4250 KG (approx. 1672 KG payload) upto <strong>GCM Increase</strong> rating  8750 KG * ZR2 8450 KG.</li><li><strong>Key Features:</strong> Fox 2.5 Performance Elite suspension, ORI 400 KG leaf packs, and <strong>required load-rated wheels/tyres</strong>.</li><li><strong>Best For:</strong> Fully built rigs with rear drawer systems, rooftop tents, and long-range tanks or the ultimate tourer with Tray and Canopies fitted.</li><li><strong>Benefit:</strong> Massive payload increase that transforms the Silverado into a true heavy-duty platform while retaining 4.5T braking towing capacity.</li><li><em><strong>Note: Chevy Silverado ZR2 has reduced GCM due to the 4.2T towing capacity.</strong></em></li><li><strong>Part Number 200 KG Leaf Pack: </strong>CHV-1500-Stage4-GVM-200</li><li><strong>Part Number 400 KG Leaf Pack: </strong>CHV-1500-Stage4-GVM-400</li></ul>"
          }
